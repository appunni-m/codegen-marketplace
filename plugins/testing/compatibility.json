{
  "coverageMcp": {
    "healthUrl": "http://127.0.0.1:59471/health",
    "connector": {
      "command": "coverage-mcp",
      "args": ["connect"]
    },
    "localDevelopment": {
      "command": "cargo",
      "args": [
        "run",
        "--locked",
        "--manifest-path",
        "<coverage-mcp-checkout>/Cargo.toml",
        "--",
        "connect"
      ]
    }
  }
}
